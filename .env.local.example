# ============================================
# Justin's Personal Page — Live Data Endpoints
# ============================================
# Copy this file to `.env.local` and fill in the values for your setup.

# ============================================
# Admin Panel — Database + Auth
# ============================================
# SQLite is used by default — no configuration needed.
# The database file is created automatically at ./data/app.db
#
# Optional: use a custom SQLite file path
# SQLITE_PATH=./data/app.db

# Optional: switch to MariaDB/MySQL by setting all four variables below.
# When DB_HOST, DB_USER, DB_PASSWORD, and DB_NAME are all set, MySQL is
# used instead of SQLite.
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=exampleuser
# DB_PASSWORD=examplepassword
# DB_NAME=exampledatabase

# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string

# Timezone for the Node.js process — affects how timestamps are displayed in the admin panel.
# SQLite stores timestamps as UTC internally; this setting controls the local-time offset used
# when formatting them for display. Restart the dev server after changing this.
# Examples: Europe/Berlin, America/New_York, Asia/Tokyo
# TZ=Europe/Berlin

# Optional: force admin_session cookie Secure flag (true/false). Defaults to true on HTTPS, false on HTTP.
# ADMIN_COOKIE_SECURE=false

# ============================================
# ADS-B
# ============================================
# tar1090 / readsb / dump1090 — should return a JSON payload containing an `aircraft` array.
# Example for a local tar1090 instance:
#   http://tar1090.lan/data/aircraft.json
ADSB_ENDPOINT=

# Optional: Your receiver's coordinates to calculate the max range
# if your ADS-B software doesn't provide the `dst` field automatically.
RECEIVER_LAT=
RECEIVER_LON=

# ============================================
# BirdNET-Go
# ============================================
# Base URL of your BirdNET-Go instance (without trailing slash).
# The API proxy hits /api/v2/analytics/species/summary internally.
# Example:
#   http://birdnet.lan:8080
BIRDNET_ENDPOINT=

# ============================================
# Steam
# ============================================
# Get an API key from: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Your 17-digit SteamID64 (you can find this via steamid.io)
STEAM_ID=

# ============================================
# Uptime Kuma
# ============================================
# Base URL of your Uptime Kuma instance
# Example: https://status.example.com
UPTIME_KUMA_ENDPOINT=
# The slug of your public status page (often "default")
UPTIME_KUMA_SLUG=default

# ============================================
# Home Assistant
# ============================================
# Base URL of your Home Assistant instance
# Example: http://homeassistant.local:8123
HA_URL=
# Long-Lived Access Token generated from your HA user profile
HA_TOKEN=
# Option A — grouped sensors (takes precedence over HA_SENSORS)
# Format: "GroupLabel:entity1=DisplayName,entity2|GroupLabel2:entity3"
# The =DisplayName suffix is optional; omit it to use HA's friendly_name.
# Example:
#   HA_SENSOR_GROUPS=Indoor:sensor.indoor_temperature=Temperature,sensor.indoor_humidity=Humidity|Outdoor:sensor.outdoor_temperature=Temperature,sensor.outdoor_humidity=Humidity
HA_SENSOR_GROUPS=
# Option B — flat list of sensor entity IDs (used when HA_SENSOR_GROUPS is not set)
# Optional =DisplayName suffix per entry; omit to use HA's friendly_name.
# Example: sensor.living_room_temperature=Temperature,sensor.living_room_humidity=Humidity
HA_SENSORS=
